---
const SUGGESTED_QUESTION = "What has Garrett built recently?";
---

<div id="ask" class="scroll-mt-24">
  <form data-ask-form class="relative">
    <input
      data-ask-input
      type="text"
      maxlength="500"
      value={SUGGESTED_QUESTION}
      aria-label="Ask a question about Garrett"
      autocomplete="off"
      class="w-full rounded-full bg-[color:var(--color-panel)] border border-[color:var(--color-line)] pl-6 pr-24 sm:pr-28 py-4 text-base text-[color:var(--color-muted)] focus:outline-none focus:border-[color:var(--color-lime)] transition-colors"
    />
    <button
      type="submit"
      data-ask-send
      class="absolute right-2 top-1/2 -translate-y-1/2 mono text-sm px-4 sm:px-5 py-2.5 rounded-full bg-[color:var(--color-lime)] text-[color:var(--color-ink)] hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed transition-opacity"
    >
      Ask →
    </button>
  </form>
  <p data-ask-hint class="mono text-xs text-[color:var(--color-muted)] mt-2 ml-2">
    Ask anything about Garrett's background, skills, or projects.
  </p>

  <div data-ask-messages class="hidden mt-6 space-y-3 text-sm"></div>
</div>

<script>
  const MAX_TURNS = 12;

  const form = document.querySelector<HTMLFormElement>('[data-ask-form]');
  const input = document.querySelector<HTMLInputElement>('[data-ask-input]');
  const sendButton = document.querySelector<HTMLButtonElement>('[data-ask-send]');
  const messages = document.querySelector<HTMLDivElement>('[data-ask-messages]');
  const hint = document.querySelector<HTMLParagraphElement>('[data-ask-hint]');

  type Message = { role: 'user' | 'assistant'; content: string };
  const history: Message[] = [];
  let touched = false;

  // The input starts pre-filled with a suggested question, dimmed so it reads
  // as a suggestion rather than something the visitor typed. Selecting on
  // focus means the first keystroke just replaces it; the dimming clears the
  // moment they actually edit it, so it reads as "theirs" either way.
  function markTouched() {
    if (touched || !input) return;
    touched = true;
    input.classList.remove('text-[color:var(--color-muted)]');
    input.classList.add('text-[color:var(--color-paper)]');
  }

  input?.addEventListener('focus', () => {
    if (!touched) input.select();
  });
  input?.addEventListener('input', markTouched);

  // Assistant replies may use **bold** for key terms and "- " bullet lines
  // for structure (per the chat's knowledge base rules), and reference this
  // site's own pages and Garrett's real profile URLs — all of that gets
  // rendered properly here instead of showing as literal markdown/plain
  // text. HTML-escape first, then only well-defined bold/link patterns are
  // turned into markup, so nothing from model output can inject arbitrary
  // HTML even though the result is inserted via innerHTML.
  const KNOWN_DOMAINS =
    'github\\.com/GarrettShrop|(?:www\\.)?linkedin\\.com/in/garrett-shropshire|(?:www\\.)?youtube\\.com/@GS46Codes|x\\.com/GarrettDevCodes|gs46tech\\.com|myfundflow\\.app|limoscenellc\\.com|advisors360pwm\\.com';
  const LINK_PATTERN = new RegExp(
    // Email TLD is letters-only (not the looser [\w.-]+) so a sentence-ending
    // period after an address ("...gmail.com.") isn't swallowed into the link.
    `(https?://[^\\s<]+)|([\\w.+-]+@[\\w-]+\\.[a-zA-Z]{2,})|(?<![\\w/])(/(?:projects|experience|skills|streaming))(?![\\w/])|\\b(${KNOWN_DOMAINS})`,
    'g',
  );

  function escapeHtml(text: string): string {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Runs on already-escaped text. Bold first, then links — a URL wrapped in
  // **bold** just ends up with the <a> nested inside the <strong>, which is
  // valid and renders fine.
  function inlineFormat(escapedText: string): string {
    const bolded = escapedText.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    return bolded.replace(LINK_PATTERN, (match, url, email, path, domain) => {
      const linkClass = 'underline decoration-dotted hover:text-[color:var(--color-lime)]';
      if (url) {
        // A URL at the end of a sentence greedily swallows the trailing
        // punctuation ("...gs46tech.com."). Strip it off the link and put
        // it back after, so the sentence keeps its period.
        const trailingMatch = url.match(/[.,;:!?]+$/);
        const trailing = trailingMatch ? trailingMatch[0] : '';
        const cleanUrl = trailing ? url.slice(0, -trailing.length) : url;
        return `<a href="${cleanUrl}" target="_blank" rel="noopener noreferrer" class="${linkClass}">${cleanUrl}</a>${trailing}`;
      }
      if (email) return `<a href="mailto:${email}" class="${linkClass}">${email}</a>`;
      if (path) return `<a href="${path}" class="${linkClass}">${path}</a>`;
      if (domain) return `<a href="https://${domain}" target="_blank" rel="noopener noreferrer" class="${linkClass}">${domain}</a>`;
      return match;
    });
  }

  // Splits a reply into paragraph/list blocks on the raw (pre-inline-format)
  // text, so bold/link matching in inlineFormat never has to reason about
  // block-level tags — it only ever sees plain escaped text per block.
  function formatReply(raw: string): string {
    const lines = escapeHtml(raw).split('\n');
    const blocks: string[] = [];
    let paragraph: string[] = [];
    let listItems: string[] = [];

    const flushParagraph = () => {
      if (paragraph.length) {
        blocks.push(`<p>${inlineFormat(paragraph.join(' '))}</p>`);
        paragraph = [];
      }
    };
    const flushList = () => {
      if (listItems.length) {
        blocks.push(`<ul class="list-disc pl-5 space-y-1">${listItems.map((item) => `<li>${inlineFormat(item)}</li>`).join('')}</ul>`);
        listItems = [];
      }
    };

    for (const rawLine of lines) {
      const line = rawLine.trim();
      if (!line) {
        flushParagraph();
        flushList();
        continue;
      }
      const bullet = line.match(/^[-*]\s+(.*)$/);
      if (bullet) {
        flushParagraph();
        listItems.push(bullet[1]);
      } else {
        flushList();
        paragraph.push(line);
      }
    }
    flushParagraph();
    flushList();

    return blocks.join('');
  }

  function renderMessage(role: Message['role'], content: string) {
    if (!messages) return;
    messages.classList.remove('hidden');
    const bubble = document.createElement('div');
    bubble.className =
      role === 'user'
        ? 'ml-auto max-w-[85%] lg:max-w-2xl rounded-lg rounded-br-sm bg-[color:var(--color-lime)] text-[color:var(--color-ink)] px-4 py-2.5'
        : 'mr-auto max-w-[85%] lg:max-w-2xl rounded-lg rounded-bl-sm bg-[color:var(--color-panel)] border border-[color:var(--color-line)] px-4 py-2.5 text-[color:var(--color-paper)] [&_strong]:text-[color:var(--color-lime)] [&_strong]:font-semibold [&_p:not(:last-child)]:mb-2 [&_ul:not(:last-child)]:mb-2';
    if (role === 'assistant') {
      bubble.innerHTML = formatReply(content);
    } else {
      bubble.textContent = content;
    }
    messages.appendChild(bubble);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const text = input?.value.trim();
    if (!text || !input || !sendButton) return;

    markTouched();
    renderMessage('user', text);
    history.push({ role: 'user', content: text });
    if (history.length > MAX_TURNS) history.splice(0, history.length - MAX_TURNS);

    input.value = '';
    input.disabled = true;
    sendButton.disabled = true;
    hint?.classList.add('hidden');

    const thinking = document.createElement('p');
    thinking.className = 'mr-auto text-[color:var(--color-muted)] mono text-xs';
    thinking.textContent = 'thinking…';
    messages?.appendChild(thinking);

    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });

      thinking.remove();

      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        renderMessage('assistant', err.error ?? 'Something went wrong on my end — try again in a moment.');
        return;
      }

      const data = await response.json();
      renderMessage('assistant', data.reply);
      history.push({ role: 'assistant', content: data.reply });
    } catch {
      thinking.remove();
      renderMessage('assistant', "Couldn't reach the server — check your connection and try again.");
    } finally {
      input.disabled = false;
      sendButton.disabled = false;
      input.placeholder = 'Ask a follow-up…';
      input.focus();
    }
  });
</script>
