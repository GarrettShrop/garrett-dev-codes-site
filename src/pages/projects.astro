---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// project.data.summary is static, author-controlled copy (not user input) —
// escape first as defense in depth, then turn **bold** markers into <strong>
// so key metrics/tech stand out from the rest of the summary.
function boldToHtml(text: string): string {
  const escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return escaped.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}
---

<Layout title="Projects">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-24">
    <div class="text-scrim">
      <p class="mono text-sm text-[color:var(--color-lime)] mb-2">// projects</p>
      <h1 class="text-4xl font-semibold mb-10">Things I've built</h1>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      {
        projects.map((project) => (
          <div data-reveal class="card p-6 flex flex-col">
            <h2 class="text-lg font-medium mb-2">{project.data.title}</h2>
            <p
              class="text-sm text-[color:var(--color-muted)] leading-relaxed flex-1 [&_strong]:text-[color:var(--color-lime)] [&_strong]:font-semibold"
              set:html={boldToHtml(project.data.summary)}
            />
            {project.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-4">
                {project.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
            {(project.data.url || project.data.appStoreUrl) && (
              <div class="flex flex-wrap gap-x-4 gap-y-1 mt-4">
                {project.data.url && (
                  <a
                    href={project.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mono text-sm text-[color:var(--color-lime)] inline-flex items-center gap-1 hover:underline"
                  >
                    Visit →
                  </a>
                )}
                {project.data.appStoreUrl && (
                  <a
                    href={project.data.appStoreUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mono text-sm text-[color:var(--color-lime)] inline-flex items-center gap-1 hover:underline"
                  >
                    App Store →
                  </a>
                )}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>
</Layout>
