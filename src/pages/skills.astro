---
import Layout from '../layouts/Layout.astro';
import { skillGroups } from '../data/site';
import { resources } from '../data/resources';

const tools = resources.filter((r) => r.section === 'tools');
---

<Layout title="Skills">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-16">
    <div class="text-scrim">
      <p class="mono text-sm text-[color:var(--color-lime)] mb-2">// skills</p>
      <h1 class="text-4xl font-semibold mb-10">What I work with</h1>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      {
        skillGroups.map((group) => (
          <div data-reveal class="card p-6">
            <h2 class="mono text-xs text-[color:var(--color-muted)] uppercase tracking-wide mb-3">{group.label}</h2>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="tag">{skill}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div data-reveal class="card p-8">
      <p class="mono text-xs text-[color:var(--color-lime)] mb-2">// tools I recommend</p>
      <div class="flex flex-wrap gap-2 mb-5">
        {
          tools.map((r) => (
            <a
              href={`/resources#${r.id}`}
              class="tag hover:text-[color:var(--color-lime)]"
            >
              {r.title}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-x-6 gap-y-2">
        <a href="/resources#tools" class="mono text-sm text-[color:var(--color-lime)] hover:underline">Full list with notes →</a>
        <a href="/resources#skills" class="mono text-sm text-[color:var(--color-lime)] hover:underline">Skills I use and recommend →</a>
      </div>
    </div>
  </section>
</Layout>
