---
import Layout from '../layouts/Layout.astro';
import { sections, resources, skillReview, vaultOutline, disclaimer, channelLinks } from '../data/resources';

const platformLabels: Record<string, string> = {
  youtube: 'YouTube',
  tiktok: 'TikTok',
  facebook: 'Facebook',
};

const linkClass = 'mono text-sm text-[color:var(--color-lime)] hover:underline';
---

<Layout title="Resources">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-24">
    <div class="text-scrim">
      <p class="mono text-sm text-[color:var(--color-lime)] mb-2">// resources</p>
      <h1 class="text-4xl font-semibold mb-4">Everything I share</h1>
      <p class="text-[color:var(--color-muted)] mb-4">
        Links to the skills, tools and setup I use. Click through to the source.
      </p>
    </div>
    <p class="text-xs italic text-[color:var(--color-muted)] border-l-2 border-[color:var(--color-line)] pl-3 mb-8">
      {disclaimer}
    </p>

    <nav aria-label="Resources sections" class="flex flex-wrap gap-2 mb-16">
      {
        sections.map((s) => (
          <a href={`#${s.id}`} class="tag hover:text-[color:var(--color-lime)]">
            {s.label}
          </a>
        ))
      }
    </nav>

    <div class="space-y-16">
      {
        sections.map((s) => {
          const entries = resources.filter((r) => r.section === s.id);
          return (
            <section id={s.id} class="scroll-mt-24">
              <div class="text-scrim mb-6">
                <p class="mono text-sm text-[color:var(--color-lime)] mb-2">// {s.id}</p>
                <h2 class="text-2xl font-semibold mb-2">{s.label}</h2>
                <p class="text-[color:var(--color-muted)]">{s.intro}</p>
              </div>

              {entries.length > 0 ? (
                <div class:list={['grid sm:grid-cols-2 gap-5', s.id === 'tools' && 'lg:grid-cols-3']}>
                  {entries.map((r) => (
                    <div id={r.id} data-reveal class="card p-6 flex flex-col scroll-mt-24 min-w-0">
                      <div class="flex items-start justify-between gap-3 mb-2">
                        <h3 class="text-lg font-medium break-words min-w-0">
                          {r.url ? (
                            <a
                              href={r.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="hover:text-[color:var(--color-lime)]"
                            >
                              {r.title}
                            </a>
                          ) : (
                            r.title
                          )}
                        </h3>
                        <a
                          href={`#${r.id}`}
                          aria-label={`Link to ${r.title}`}
                          class="mono text-sm text-[color:var(--color-muted)] hover:text-[color:var(--color-lime)] shrink-0"
                        >
                          #
                        </a>
                      </div>
                      <p class="text-sm text-[color:var(--color-muted)] leading-relaxed flex-1">{r.description}</p>
                      {(r.license || r.referral) && (
                        <div class="flex flex-wrap gap-2 mt-4">
                          {r.license && <span class="tag">{r.license}</span>}
                          {r.referral && <span class="tag">Referral link</span>}
                        </div>
                      )}
                      {r.referral && (
                        <div class="text-sm mt-3 space-y-1">
                          <p class="text-[color:var(--color-muted)] leading-relaxed">{r.referral.perk}</p>
                          {r.referral.links && (
                            <p class="mono flex flex-wrap gap-x-4 gap-y-1">
                              <span class="text-[color:var(--color-muted)]">Try it:</span>
                              {r.referral.links.map((l) => (
                                <a href={l.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                                  {l.label}
                                </a>
                              ))}
                            </p>
                          )}
                        </div>
                      )}
                      {r.videos && (
                        <div class="mono text-sm mt-4 space-y-1">
                          <p class="flex flex-wrap gap-x-4 gap-y-1">
                            <span class="text-[color:var(--color-muted)]">Watch on YouTube:</span>
                            {r.videos.map((v) => (
                              <a href={v.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                                {v.label}
                              </a>
                            ))}
                          </p>
                          <p class="flex flex-wrap gap-x-4 gap-y-1">
                            <span class="text-[color:var(--color-muted)]">Also on:</span>
                            {channelLinks
                              .filter((c) => c.id !== 'youtube')
                              .map((c) => (
                                <a href={c.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                                  {platformLabels[c.id] ?? c.title}
                                </a>
                              ))}
                          </p>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                s.comingSoon && (
                  <div data-reveal class="card p-6">
                    <p class="text-sm text-[color:var(--color-muted)] leading-relaxed">{s.comingSoon}</p>
                  </div>
                )
              )}

              {s.id === 'skills' && (
                <div data-reveal class="card p-6 mt-5">
                  <p class="text-sm leading-relaxed mb-4">
                    Listing a collection here doesn't mean I've vetted every skill inside it. When I download a skill, this is what I do:
                  </p>
                  <ol class="space-y-3 text-sm">
                    {skillReview.map((item, i) => (
                      <li class="flex flex-col sm:flex-row gap-1 sm:gap-3">
                        <span class="mono text-[color:var(--color-lime)] shrink-0 sm:w-56">
                          {i + 1}. {item.step}
                        </span>
                        <span class="text-[color:var(--color-muted)] leading-relaxed">{item.text}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              )}

              {s.id === 'vault' && (
                <ol class="grid sm:grid-cols-3 gap-x-8 gap-y-8 mt-8 list-none">
                  {vaultOutline.map((step, i) => (
                    <li data-reveal class="card p-5 relative min-w-0">
                      <p class="mono text-sm text-[color:var(--color-lime)] mb-1">{String(i + 1).padStart(2, '0')}</p>
                      <h3 class="text-base font-medium mb-2">{step.title}</h3>
                      <p class="text-sm text-[color:var(--color-muted)] leading-relaxed">{step.text}</p>
                      {i < vaultOutline.length - 1 && (
                        <span
                          aria-hidden="true"
                          class="sm:hidden absolute inset-x-0 -bottom-8 h-8 flex items-center justify-center mono text-lg text-[color:var(--color-lime)]"
                        >
                          ↓
                        </span>
                      )}
                      {i < vaultOutline.length - 1 && i % 3 !== 2 && (
                        <span
                          aria-hidden="true"
                          class="hidden sm:flex absolute inset-y-0 -right-8 w-8 items-center justify-center mono text-lg text-[color:var(--color-lime)]"
                        >
                          →
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              )}
            </section>
          );
        })
      }
    </div>
  </section>
</Layout>
