---
import Layout from '../layouts/Layout.astro';
import AskAnything from '../components/AskAnything.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const experience = await getCollection('experience');
// Multiple entries are "current" (job, GS46 Tech, MyFundFlow) — the primary
// role for the hero is whichever one started most recently.
const current = experience
  .filter((e) => e.data.current)
  .sort((a, b) => new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime())[0];

// site.bio is static, author-controlled copy (not user input) — escape first
// as defense in depth, then turn its **bold** markers into <strong> tags so
// key numbers/names can be highlighted against the page background.
function boldToHtml(text: string): string {
  const escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return escaped.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}
---

<Layout title="About">
  <section data-hero class="text-scrim max-w-5xl mx-auto px-6 pt-20 pb-16">
    <p data-hero-item class="mono text-sm text-[color:var(--color-lime)] mb-4">$ whoami</p>
    <h1 data-hero-item class="text-5xl sm:text-6xl font-semibold tracking-tight leading-[1.05]">
      Garrett Shropshire
    </h1>
    <p data-hero-item class="mt-4 text-xl text-[color:var(--color-muted)] max-w-2xl">
      Software engineer, BI analyst, AI adopter, and founder — currently <span class="glow-text">{current?.data.role}</span> at <span class="text-[color:var(--color-paper)]">{current?.data.org}</span>.
    </p>

    <div data-hero-item class="mt-8">
      <AskAnything />
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-16">
    <div data-reveal class="card p-8 flex flex-col sm:flex-row gap-8">
      <img
        src="/headshot.jpg"
        alt="Garrett Shropshire"
        class="w-32 h-32 sm:w-40 sm:h-40 rounded-2xl object-cover border border-[color:var(--color-line)] shrink-0"
      />
      <div>
        <p class="mono text-xs text-[color:var(--color-muted)] mb-4">// about</p>
        <div
          class="space-y-4 text-[color:var(--color-paper)] leading-relaxed whitespace-pre-line [&_strong]:text-[color:var(--color-lime)] [&_strong]:font-semibold"
          set:html={boldToHtml(site.bio)}
        />
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-16 grid sm:grid-cols-3 gap-4">
    <div data-reveal class="card p-6">
      <p class="mono text-xs text-[color:var(--color-lime)] mb-2">Current role</p>
      <p class="font-medium">{current?.data.role}</p>
      <p class="text-sm text-[color:var(--color-muted)]">{current?.data.org}</p>
    </div>
    <div data-reveal class="card p-6">
      <p class="mono text-xs text-[color:var(--color-lime)] mb-2">Side business</p>
      <p class="font-medium">GS46 Tech</p>
      <p class="text-sm text-[color:var(--color-muted)]">Owner, since Aug 2023</p>
    </div>
    <div data-reveal class="card p-6">
      <p class="mono text-xs text-[color:var(--color-lime)] mb-2">Currently learning</p>
      <p class="font-medium">Cybersecurity</p>
      <p class="text-sm text-[color:var(--color-muted)]">Plus deeper RAG + multi-agent work</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-24 grid sm:grid-cols-2 gap-4">
    <a
      href="/experience"
      class="card group p-6 hover:border-[color:var(--color-lime)]/40 transition-colors"
    >
      <p class="mono text-xs text-[color:var(--color-lime)] mb-2">// experience</p>
      <p class="font-medium flex items-center gap-2">
        Full work history
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </p>
      <p class="text-sm text-[color:var(--color-muted)] mt-1">Every role, with dates and details.</p>
    </a>
    <a
      href="/projects"
      class="card group p-6 hover:border-[color:var(--color-lime)]/40 transition-colors"
    >
      <p class="mono text-xs text-[color:var(--color-lime)] mb-2">// projects</p>
      <p class="font-medium flex items-center gap-2">
        Things I've built
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </p>
      <p class="text-sm text-[color:var(--color-muted)] mt-1">MyFundFlow, GS46 Tech, OpenClaw, and more.</p>
    </a>
  </section>
</Layout>
